# Copy this file to .env and fill in values.
# .env is git-ignored; never commit real secrets.

# === Docker Compose ===
POSTGRES_PASSWORD=devpassword

# === Portcullis Server ===
PORTCULLIS_ENV=development
PORTCULLIS_ADDR=:8080
PORTCULLIS_LOG_LEVEL=debug

# === Database & Cache ===
PORTCULLIS_DATABASE_URL=postgres://portcullis:devpassword@127.0.0.1:5432/portcullis?sslmode=disable
PORTCULLIS_REDIS_URL=redis://127.0.0.1:6379/0

# === Secrets ===
# Admin key gates /admin/* endpoints. Generate fresh: openssl rand -hex 32
PPORTCULLIS_ADMIN_KEY=set-me-please

# HMAC pepper for gateway key verification. Generate fresh: openssl rand -hex 32
# Rotating this invalidates ALL existing gateway keys. Production: never rotate.

PORTCULLIS_KEY_PEPPER=set-me-please
# AES-256 master key for upstream secret encryption. Generate fresh:
#   openssl rand -base64 32
# Rotating requires re-encrypting all stored upstream secrets. (Phase 4)
PORTCULLIS_MASTER_KEY=set-me-please
